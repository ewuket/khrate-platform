{
  "name": "khrate",
  "private": true,
  "version": "0.0.1",
  "description": "KHRATE — grocery buying, group buying & delivery platform for Kigali.",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web",
    "apps/admin"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:admin": "npm run dev --workspace apps/admin",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:migrate": "npm run prisma:migrate --workspace apps/api",
    "prisma:generate": "npm run prisma:generate --workspace apps/api"
  },
  "engines": {
    "node": ">=20"
  }
}
