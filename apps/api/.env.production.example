# KHRATE API — PRODUCTION environment template. Copy to .env.production on the server and
# fill real values. NEVER commit the filled file. The API refuses to boot in production if
# JWT_SECRET is missing/default, or DATABASE_URL / CORS_ORIGINS are unset (fail-fast guard).

NODE_ENV=production
PORT=3001

# Postgres (compose service name `db` inside the compose network).
DATABASE_URL="postgresql://khrate:CHANGE_ME_STRONG_PASSWORD@db:5432/khrate?schema=public"
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_VALUE

# Exact origins of the customer web app and admin app (comma-separated).
CORS_ORIGINS=https://shop.example.rw,https://ops.example.rw

# Launch payment provider (manual MoMo verification). Future: MOMO_API etc. (ADR-0008).
PAYMENT_PROVIDER=MOMO_MANUAL
