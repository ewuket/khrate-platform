# KHRATE API — copy to .env for local dev. NEVER commit real secrets or credentials.
NODE_ENV=development
PORT=3001

# Local Postgres from docker-compose (note non-default host port 5434).
DATABASE_URL="postgresql://khrate:khrate@localhost:5434/khrate?schema=public"

# Auth
JWT_SECRET="khrate-dev-secret-change-me"

# Active payment provider. Launch = MOMO_MANUAL (staff-verified). No real credentials here.
PAYMENT_PROVIDER=MOMO_MANUAL
